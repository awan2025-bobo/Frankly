# Copy to .env and fill in. Never commit .env.
# These two are safe to ship in the app (Supabase dashboard -> Project Settings -> API):
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# These are SECRETS. They do NOT go in .env for the app. Set them as Supabase secrets:
#   npx supabase secrets set ANTHROPIC_API_KEY=... KROGER_CLIENT_ID=... KROGER_CLIENT_SECRET=...
# ANTHROPIC_API_KEY=
# KROGER_CLIENT_ID=
# KROGER_CLIENT_SECRET=
